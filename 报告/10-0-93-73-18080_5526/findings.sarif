          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "未授权路径穿越导致任意文件读取（/api/files 与 /static 双向量）\n\n目标 `http://10.0.93.73:18080` 的 Nexus 网关文件模块存在路径穿越缺陷。未认证攻击者可通过 `/api/files?path=` 参数或静态资源路由 `/static/../` 读取服务器上任意可读文件，包括 `/etc/passwd`、`/etc/hosts`、应用配置 `/app/config.yml` 以及 `/app/.git/config`（内含 GitLab 访问令牌）。`/api/files` 在未提供参数时还会返回整个文件系统的目录列表。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "SECURITY.md"
                }
              }
            },
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "/api/files",
                  "kind": "endpoint"
