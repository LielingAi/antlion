        {
          "ruleId": "strix-coverage/authorization-bypass-path-normalization-header-cookie-spoofing-method-switching",
          "ruleIndex": 26,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Authorization bypass (path normalization, header/cookie spoofing, method switching) — Ruled out: /admin, /backup, /api/internal, /config (level-gated routes)\n\nAll variants returned 403 or 404: /admin/, //admin, /./admin, /%2e/admin, /%61dmin, /ADMIN, /admin%20, /admin;.css, /admin/..;/admin, /;/admin, ?x=1; X-Forwarded-For/X-Real-IP/X-Originating-IP/X-Forwarded-Host/X-Original-URL/X-Rewrite-URL and X-Level/X-Auth-Level/X-Nexus-Level/X-Role headers; level/auth/access/clearance cookies and query params; POST/PUT/HEAD/OPTIONS/PATCH/TRACE. The level check is evaluated server-side on the canonical path and is not overridable by client-controlled headers, cookies or parameters (the separate /actuator child gap is recorded elsewhere)."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "/admin, /backup, /api/internal, /config (level-gated routes)"
