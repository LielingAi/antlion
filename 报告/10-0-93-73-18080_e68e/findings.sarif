            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "needs_follow_up",
              "risk_area": "Remote code execution",
              "surface": "RCE escalation chain from file read (/debug, /actuator/env, SQL backend, Redis 16379, K8s API 6443)",
              "recorded_by": "FileRead RCE Specialist",
              "source": "agent_reported"
            }
          }
        },
