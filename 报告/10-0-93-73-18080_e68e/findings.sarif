              "risk_area": "Credential validity / unauthorized production database access",
              "surface": "PostgreSQL 10.0.93.73:15432 (nexus_prod) using leaked prod_admin password",
              "recorded_by": "Credential Chain Specialist",
              "source": "agent_reported"
            }
          }
