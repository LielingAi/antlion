          "properties": {
            "security-severity": "3.7",
            "strix_vuln_class_hash": "274f32957413e0d24e1008afd9af4400b8410c2dd746bfb3908224919bd5e03d",
            "synthetic_location": true,
            "strix": {
              "id": "vuln-0010",
              "severity": "low",
              "cvss": 3.7,
