        {
          "ruleId": "strix-coverage/arbitrary-file-write-upload-leading-to-code-execution",
          "ruleIndex": 17,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Arbitrary file write / upload leading to code execution — Ruled out: File write / upload via /api/files and /api/bounty/submit\n\n/api/files rejects POST, PUT and PATCH with 405 \"Request method not supported\" (handler is GET-only, no body/upload handling); /api/bounty/submit returns a static queued response for GET/POST-JSON/form/multipart and creates no artifact (/app/logs stayed empty, /app/uploads absent). No write primitive reachable from the file module."
          },
          "locations": [
