        {
          "ruleId": "strix-coverage/remote-code-execution",
          "ruleIndex": 18,
          "kind": "open",
          "level": "none",
          "message": {
            "text": "Remote code execution — Requires further review: RCE escalation chain from file read (/debug, /actuator/env, SQL backend, Redis 16379, K8s API 6443)\n\nNo RCE obtained. Named blockers: /debug is a static page (identical 10029-byte body regardless of cmd/exec params); Actuator env is GET-only (POST → 405); the SQL backend rejects pg_read_file and COPY ... TO PROGRAM and returns canned rows (select 1+1 → '1'), so no SQL-to-file/program path; Redis 16379 accepts TCP but never replies to RESP (AUTH/PING), so CONFIG SET/SAVE cannot be exercised; leaked K8s token and 10.99.0.1:6443 / 10.99.0.1:8081 are unreachable through the egress proxy (Caido 502) — credential validity therefore unverified."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "RCE escalation chain from file read (/debug, /actuator/env, SQL backend, Redis 16379, K8s API 6443)"
                }
